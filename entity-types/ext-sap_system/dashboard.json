{
  "name": "EXT-SAP_SYSTEM",
  "description": null,
  "pages": [
    {
      "name": "System",
      "description": null,
      "widgets": [
        {
          "title": "Availability",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT (1-average(NR.SAP.SYSTEM.INSTANCE.AVAILABILITY)) * 100 AS ABAP SINCE 1 day ago TIMESERIES AUTO"
              },
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT average(ABAP.System.Heartbeat) WHERE sap.provider = 'hm' AND measure = 'okStatus' SINCE 1 day ago TIMESERIES AUTO LIMIT MAX"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Trend  -  Dialog Response Time (seconds)",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT average(NR.SAP.SYSTEM.DIALOG.RESPONSE_TIME) / 1000 as 'ABAP' SINCE 1 day ago TIMESERIES AUTO"
              },
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT average(ABAP.ResponseTime)/1000 AS 'CALM' WHERE sap.provider = 'hm' AND Tasktype = 'Dialog' AND measure = 'value' SINCE 1 day ago TIMESERIES AUTO"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Trend - Error (count)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountId": 0, 
                "query": "FROM Log SELECT count(*) WHERE (collector.name = 'nr-sap-connector' AND sap.provider = 'exm.im' AND exception.type = 'ABAP Runtime') OR CATEGORY = 'ABAP Runtime Error' SINCE 1 hour ago LIMIT MAX TIMESERIES AUTO"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Trend - Enqueue Entries",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT average(NR.SAP.SYSTEM.ENQUEUE.INFORMATION) AS 'ABAP Enque' WHERE KEY_FIGURE = 'Total Enqueues' SINCE 1 day ago TIMESERIES AUTO"
              },
              {
                "accountId": 0, 
                "query": "FROM Metric SELECT average(ABAP.Enqueue.Entries.Total) AS 'CALM Enque'  WHERE (collector.name = 'nr-sap-connector' AND sap.provider = 'hm' AND metricName = 'ABAP.Enqueue.Entries.Total' AND measure = 'value') SINCE 1 day ago TIMESERIES AUTO LIMIT MAX"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Runtime Error Logs",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "dataFormatters": [],
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountId": 0, 
                "query": "FROM Log SELECT if (collector.name = 'nr-sap-connector', sap.exm.category, CATEGORY) AS Category, if (collector.name = 'nr-sap-connector', Subcategory, SUBCATEGORY) AS SubCategory, message, messageId, if (collector.name = 'nr-sap-connector', PROG, PRG_NAME) AS Prog  WHERE (collector.name = 'nr-sap-connector' AND sap.provider = 'exm.im' AND exception.type = 'ABAP Runtime') OR CATEGORY = 'ABAP Runtime Error' SINCE 1 day ago LIMIT MAX"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ]
}
