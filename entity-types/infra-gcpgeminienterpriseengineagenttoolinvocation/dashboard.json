{
  "name": "Gemini Enterprise Engine Agent Tool Invocation",
  "description": "Dashboard for Gemini Enterprise Engine Agent Tool Invocation entities (GCP Gemini Enterprise / Discovery Engine).",
  "pages": [
    {
      "name": "Gemini Enterprise Engine Agent Tool Invocation",
      "description": null,
      "widgets": [
        {
          "title": "Tool Latency",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.tool_total_latencies`) AS 'Tool Latency' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
