{
  "name": "Discovery Engine",
  "description": "Dashboard for Discovery Engine entities (GCP Gemini Enterprise / Discovery Engine).",
  "pages": [
    {
      "name": "Discovery Engine",
      "description": null,
      "widgets": [
        {
          "title": "Request Count",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.engine.request_count`) AS 'Request Count' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Error Rate",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT filter(sum(`gcp.discoveryengine.engine.request_count`), WHERE metric.response_code_class IN ('4xx','5xx')) * 100 / sum(`gcp.discoveryengine.engine.request_count`) AS 'Error Rate' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Request Latency",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.engine.request_total_latency`) AS 'Request Latency' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Time to First Token",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.engine.time_to_first_token_latency`) AS 'Time to First Token' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Time to First Answer",
          "layout": {
            "column": 5,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.engine.time_to_first_answer_latency`) AS 'Time to First Answer' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Requests by API Method",
          "layout": {
            "column": 9,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.engine.request_count`) AS 'Requests by API Method' FROM Metric WHERE entity.guid = '{{entity.id}}' FACET metric.method TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Requests by Query Type",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.engine.request_count`) AS 'Requests by Query Type' FROM Metric WHERE entity.guid = '{{entity.id}}' FACET metric.query_type TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Requests by Model",
          "layout": {
            "column": 5,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.engine.request_count`) AS 'Requests by Model' FROM Metric WHERE entity.guid = '{{entity.id}}' FACET metric.model_id TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        }
      ]
    }
  ]
}
