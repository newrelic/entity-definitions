{
  "name": "Discovery Engine Location",
  "description": "Dashboard for Discovery Engine Location entities (GCP Gemini Enterprise / Discovery Engine).",
  "pages": [
    {
      "name": "Discovery Engine Location",
      "description": null,
      "widgets": [
        {
          "title": "Engines",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(`gcp.discoveryengine.engines_regional`) AS 'Engines' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Data Stores",
          "layout": {
