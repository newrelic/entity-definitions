      "widgets": [
        {
          "title": "Enterprise Plus WTU Quota Exceeded",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.quota.ratev2.agentic_wtu_tier_enterprise_plus_ppu_weekly_regional.exceeded`) AS 'Enterprise Plus WTU Quota Exceeded' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
