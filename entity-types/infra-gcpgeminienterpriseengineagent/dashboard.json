{
  "name": "Gemini Enterprise Engine Agent",
  "description": "Dashboard for Gemini Enterprise Engine Agent entities (GCP Gemini Enterprise / Discovery Engine).",
  "pages": [
    {
      "name": "Gemini Enterprise Engine Agent",
      "description": null,
      "widgets": [
        {
          "title": "Session Count",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.agent_session_count`) AS 'Session Count' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Turn Count",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.agent_turn_count`) AS 'Turn Count' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Sessions With Tool Use",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT sum(`gcp.discoveryengine.agent_session_with_tool_count`) AS 'Sessions With Tool Use' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Agent Latency",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.agent_total_latencies`) AS 'Agent Latency' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Agent Latency (p95)",
          "layout": {
            "column": 5,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.agent_total_latencies.p95`) AS 'Agent Latency (p95)' FROM Metric WHERE entity.guid = '{{entity.id}}' TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
          "title": "Agent Latency by Status",
          "layout": {
            "column": 9,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(`gcp.discoveryengine.agent_total_latencies`) AS 'Agent Latency by Status' FROM Metric WHERE entity.guid = '{{entity.id}}' FACET metric.status TIMESERIES AUTO",
                "offset": 300000
              }
            ],
            "yAxisLeft": {
              "zero": true
            }
          }
        }
      ]
    }
  ]
}
