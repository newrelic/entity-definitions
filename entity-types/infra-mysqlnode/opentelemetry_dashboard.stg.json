            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Opened resources / sec",
          "layout": { "column": 7, "row": 44, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": 0, "query": "FROM Metric SELECT rate(sum(mysql.opened_resources), 1 second) AS 'opened/sec' FACET kind TIMESERIES" }
